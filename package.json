{
  "name": "trade-replay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "capture:hl": "tsx scripts/capture-hl.ts",
    "capture:pm": "tsx scripts/capture-pm.ts",
    "capture:binance": "tsx scripts/capture-binance.ts",
    "episodes": "tsx apps/cli/src/episodes.ts",
    "lint": "eslint .",
    "probe:venue": "tsx scripts/probe-venue.ts",
    "render:still": "tsx apps/cli/src/render-still.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "verify:m1": "tsx apps/cli/src/verify-m1.ts",
    "verify:m3": "tsx scripts/verify-m3.ts",
    "verify:m4": "tsx scripts/verify-m4.ts",
    "verify:m5": "tsx scripts/verify-m5.ts",
    "verify:m6": "tsx scripts/verify-m6.ts",
    "verify:m7": "tsx scripts/verify-m7.ts",
    "verify:m8": "tsx scripts/verify-m8.ts",
    "verify:sound": "tsx scripts/verify-sound.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@trade-replay/adapters": "workspace:*",
    "@trade-replay/cache": "workspace:*",
    "@trade-replay/core": "workspace:*",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "playwright": "^1.62.1",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
