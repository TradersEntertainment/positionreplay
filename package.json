    "@trade-replay/core": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "playwright": "^1.62.1",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
